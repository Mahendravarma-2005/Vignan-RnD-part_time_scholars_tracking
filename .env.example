# ==============================================================================
# VFSTR Ph.D PART-TIME SCHOLAR TRACKING PORTAL - ENVIRONMENT VARIABLES
# ==============================================================================
# Instructions:
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy your Project URL and API Keys
# 3. Add these variables in your Vercel Project Settings -> Environment Variables or local .env file
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client-side)
SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Secret Key (Server-side only for Vercel functions - bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Administrative Dean R&D Credentials
ADMIN_EMAIL=dean_rd@vignan.ac.in
ADMIN_PASSWORD=your-secure-admin-password
